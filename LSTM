        "import numpy as np\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras.preprocessing.text import Tokenizer\n",
        "from tensorflow.keras.preprocessing.sequence import pad_sequences\n",
        "from tensorflow.keras.models import Sequential\n",
        "from tensorflow.keras.layers import Embedding, LSTM, Dense\n"
      ],
      "metadata": {
        "id": "DU8pH8P5hu5l"
      },
      "execution_count": 1,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "frases = [\n",
        "    \"eu gosto de programar em python\",\n",
        "    \"eu gosto de aprender novas linguagens\",\n",
        "    \"python é uma linguagem poderosa\",\n",
        "    \"redes neurais são muito interessantes\",\n",
        "    \"machine learning é o futuro da tecnologia\",\n",
        "    \"gosto de estudar inteligência artificial\",\n",
        "    \"adoro resolver problemas com código\",\n",
        "    \"aprendizado profundo é fascinante\",\n",
        "    \"python é ótimo para ciência de dados\",\n",
        "    \"eu estudo redes neurais artificiais\",\n",
        "    \"inteligência artificial muda o mundo\",\n",
        "    \"aprendo algo novo em programação todos os dias\",\n",
        "    \"machine learning ajuda a prever resultados\",\n",
        "    \"gosto de ensinar programação para iniciantes\",\n",
        "    \"dados são o combustível da inteligência artificial\",\n",
        "    \"amo trabalhar com algoritmos e lógica\",\n",
        "    \"o futuro da tecnologia está na automação\",\n",
        "    \"aprendizado de máquina melhora com dados\",\n",
        "    \"python tem muitas bibliotecas poderosas\",\n",
        "    \"inteligência artificial é uma área em crescimento\",\n",
        "    \"adoro estudar sobre redes neurais convolucionais\",\n",
        "    \"aprendo muito praticando projetos em python\",\n",
        "    \"deep learning é parte importante da inteligência artificial\",\n",
        "    \"gosto de explorar novos frameworks de machine learning\",\n",
        "    \"estudar ciência de dados é muito empolgante\"\n",
        "]"
      ],
      "metadata": {
        "id": "Ys-jNXsuhzWS"
      },
      "execution_count": 2,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "tokenizer = Tokenizer()\n",
        "tokenizer.fit_on_texts(frases)\n",
        "total_palavras = len(tokenizer.word_index) + 1\n",
        "\n",
        "sequencias = []\n",
        "for frase in frases:\n",
        "    tokens = tokenizer.texts_to_sequences([frase])[0]\n",
        "    for i in range(1, len(tokens)):\n",
        "        n_gram = tokens[:i+1]\n",
        "        sequencias.append(n_gram)\n",
        "\n",
        "max_seq_len = max(len(x) for x in sequencias)\n",
        "sequencias = np.array(pad_sequences(sequencias, maxlen=max_seq_len, padding='pre'))\n",
        "\n",
        "X = sequencias[:, :-1]\n",
        "y = sequencias[:, -1]\n",
        "y = tf.keras.utils.to_categorical(y, num_classes=total_palavras)\n"
      ],
      "metadata": {
        "id": "AswWq7fmh6Oa"
      },
      "execution_count": 3,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "modelo = Sequential()\n",
        "modelo.add(Embedding(total_palavras, 64, input_length=max_seq_len - 1))\n",
        "modelo.add(LSTM(100))\n",
        "modelo.add(Dense(total_palavras, activation='softmax'))\n",
        "\n",
        "modelo.compile(loss='categorical_crossentropy', optimizer='adam', metrics=['accuracy'])\n"
      ],
      "metadata": {
