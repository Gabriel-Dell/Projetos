      ],
      "source": [
        "def prever_proxima_palavra(modelo, tokenizer, texto_inicial, max_seq_len, temperatura=0.3):\n",
        "\n",
        "    for _ in range(3):\n",
        "        token_list = tokenizer.texts_to_sequences([texto_inicial])[0]\n",
        "        token_list = pad_sequences([token_list], maxlen=max_seq_len - 1, padding='pre')\n",
        "        predicoes = modelo.predict(token_list, verbose=0)[0]\n",
        "        predicoes = np.log(predicoes + 1e-7) / temperatura\n",
        "        exp_preds = np.exp(predicoes)\n",
        "        predicoes = exp_preds / np.sum(exp_preds)\n",
        "        proximo_indice = np.random.choice(len(predicoes), p=predicoes)\n",
        "        proxima_palavra = \"\"\n",
        "        for palavra, index in tokenizer.word_index.items():\n",
        "            if index == proximo_indice:\n",
        "                proxima_palavra = palavra\n",
        "                break\n",
        "        if proxima_palavra:\n",
        "            texto_inicial += ' ' + proxima_palavra\n",
        "        else:\n",
        "            break\n",
        "    return texto_inicial\n",
        "\n",
        "entrada = \"deep learning\"\n",
        "resultado = prever_proxima_palavra(modelo, tokenizer, entrada, max_seq_len, temperatura=0.3)\n",
        "print(f\"Previsão: {resultado}\")"
      ]
    }
